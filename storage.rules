rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /channels/{channelCode}/transfers/{transferId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.size < 250 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
