rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /channels/{channelCode} {
      allow read, write: if signedIn();

      match /devices/{deviceId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /signals/{signalId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }

      match /transfers/{transferId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
